{
  "name": "capacity-planner",
  "version": "0.3.3",
  "description": "Lokaler Capacity Planner für Windows",
  "main": "./out/main/index.js",
  "author": "",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:drag-drop": "npm run build && node tests/drag-drop.electron.cjs",
    "test:themes": "npm run build && node tests/theme-manager.electron.cjs",
    "test:view": "npm run build && node tests/view-preferences.electron.cjs",
    "test:electron": "npm run build && node tests/run-electron.cjs",
    "test:packaged": "node tests/packaged.electron.cjs",
    "prepare:icon": "node scripts/prepare-icon.cjs",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run prepare:icon && npm run build && node scripts/build-windows.mjs",
    "build:win:dir": "npm run prepare:icon && npm run build && node scripts/build-windows.mjs --dir",
    "test:time": "npm run build && node tests/time.electron.cjs",
    "test:transfer": "npm run build && node tests/planning-transfer.electron.cjs",
    "test:weeks": "npm run build && node tests/weeks.electron.cjs",
    "test:updates": "npm run build && node tests/updates.electron.cjs",
    "preview:isolated": "electron . --user-data-dir=./out/preview-profile"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
